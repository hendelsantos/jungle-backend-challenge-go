{
  "_comment": "Templates, not applied automatically. Provisioner runs cmd/provision-sqs; runtime uses separate SDK consumer/publisher clients and SQS_CONSUMER_PROFILE/SQS_PUBLISHER_PROFILE (empty keeps the default AWS chain). LocalStack Community 4.14.0 did not enforce IAM in real probes. Explicit fictional local identities are not proof of authorization. Replace account/region/ARNs for the target environment; test positive and negative access on an enforcing broker. IAM simulation alone is not operational proof.",
  "roles": {
    "jungle-wager-producer": {
      "comment": "External game providers (or their ingress service) may ONLY send to the intake FIFO. They cannot receive, delete or administer queues.",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "SendWagersOnly",
            "Effect": "Allow",
            "Action": [
              "sqs:SendMessage",
              "sqs:GetQueueUrl"
            ],
            "Resource": [
              "arn:aws:sqs:us-east-1:000000000000:wager-transactions.fifo"
            ]
          },
          {
            "Sid": "DenyEverythingElseOnQueues",
            "Effect": "Deny",
            "Action": [
              "sqs:ReceiveMessage",
              "sqs:DeleteMessage",
              "sqs:ChangeMessageVisibility",
              "sqs:DeleteQueue",
              "sqs:CreateQueue",
              "sqs:SetQueueAttributes",
              "sqs:PurgeQueue"
            ],
            "Resource": "*"
          }
        ]
      }
    },
    "jungle-wager-consumer": {
      "comment": "The application replicas consuming the intake FIFO and dead-lettering permanently invalid envelopes.",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "ConsumeIntake",
            "Effect": "Allow",
            "Action": [
              "sqs:ReceiveMessage",
              "sqs:DeleteMessage",
              "sqs:ChangeMessageVisibility",
              "sqs:GetQueueAttributes",
              "sqs:GetQueueUrl"
            ],
            "Resource": [
              "arn:aws:sqs:us-east-1:000000000000:wager-transactions.fifo"
            ]
          },
          {
            "Sid": "DeadLetterCopies",
            "Effect": "Allow",
            "Action": [
              "sqs:SendMessage",
              "sqs:GetQueueAttributes",
              "sqs:GetQueueUrl"
            ],
            "Resource": [
              "arn:aws:sqs:us-east-1:000000000000:wager-transactions-dlq.fifo"
            ]
          },
          {
            "Sid": "DenyQueueAdministration",
            "Effect": "Deny",
            "Action": [
              "sqs:CreateQueue",
              "sqs:SetQueueAttributes",
              "sqs:DeleteQueue",
              "sqs:PurgeQueue"
            ],
            "Resource": "*"
          }
        ]
      }
    },
    "jungle-event-publisher": {
      "comment": "The outbox publisher may ONLY publish integration events; it cannot consume or mutate any queue.",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "PublishEventsOnly",
            "Effect": "Allow",
            "Action": [
              "sqs:SendMessage",
              "sqs:GetQueueUrl",
              "sqs:GetQueueAttributes"
            ],
            "Resource": [
              "arn:aws:sqs:us-east-1:000000000000:wager-events.fifo"
            ]
          },
          {
            "Sid": "DenyQueueAdministration",
            "Effect": "Deny",
            "Action": [
              "sqs:CreateQueue",
              "sqs:SetQueueAttributes",
              "sqs:DeleteQueue",
              "sqs:PurgeQueue"
            ],
            "Resource": "*"
          }
        ]
      }
    },
    "jungle-queue-admin": {
      "comment": "Provisioner only: creates and reconciles challenge queues, never consumes. Queue deletion, purge, tagging and broad listing are not needed.",
      "policy": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "ProvisionChallengeQueues",
            "Effect": "Allow",
            "Action": [
              "sqs:CreateQueue",
              "sqs:SetQueueAttributes",
              "sqs:GetQueueAttributes",
              "sqs:GetQueueUrl"
            ],
            "Resource": [
              "arn:aws:sqs:us-east-1:000000000000:wager-transactions.fifo",
              "arn:aws:sqs:us-east-1:000000000000:wager-transactions-dlq.fifo",
              "arn:aws:sqs:us-east-1:000000000000:wager-events.fifo"
            ]
          }
        ]
      }
    }
  },
  "queueResourcePolicy": {
    "comment": "Resource policy attached to each queue: only the account's designated roles may act; every other principal is denied. This is the broker-side authorization layer that the HMAC message signature complements (different layers: broker access vs financial payload authenticity).",
    "policy": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "DenyNonDesignatedPrincipals",
          "Effect": "Deny",
          "Principal": "*",
          "Action": "sqs:*",
          "Resource": [
            "arn:aws:sqs:us-east-1:000000000000:wager-transactions.fifo",
            "arn:aws:sqs:us-east-1:000000000000:wager-transactions-dlq.fifo",
            "arn:aws:sqs:us-east-1:000000000000:wager-events.fifo"
          ],
          "Condition": {
            "StringNotLike": {
              "aws:PrincipalArn": [
                "arn:aws:iam::000000000000:role/jungle-wager-producer",
                "arn:aws:iam::000000000000:role/jungle-wager-consumer",
                "arn:aws:iam::000000000000:role/jungle-event-publisher",
                "arn:aws:iam::000000000000:role/jungle-queue-admin"
              ]
            }
          }
        }
      ]
    }
  }
}
