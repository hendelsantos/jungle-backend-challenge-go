# O processo lê o ambiente; não carrega .env automaticamente.
HTTP_ADDR=:8080
LOG_LEVEL=info

# Endpoints de negócio exigem PostgreSQL e IdP externo. Com DATABASE_URL vazia
# a aplicação sobe apenas com /health/live. Exemplo local (compose.dev.yaml):
# DATABASE_URL=postgres://jungle:jungle-local@localhost:55432/jungle?sslmode=disable

# Autenticação OIDC opcional: com OIDC_ISSUER definido, DATABASE_URL passa a ser
# obrigatória e os endpoints financeiros passam a exigir tokens do IdP.
# O issuer deve ser a URL pública do realm usada pelos clientes.
# OIDC_ISSUER=http://localhost:58080/realms/jungle
# OIDC_AUDIENCE=jungle-api

# Worker de referências pendentes (ativos quando DATABASE_URL está definida).
# REFERENCE_TTL=24h
# REFERENCE_WORKER_INTERVAL=1s

# Entrada SQS local (opcional); exige DATABASE_URL e chaves dos produtores.
# O SDK usa a cadeia padrão AWS, sem fallback no adaptador. Para o broker local:
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_SESSION_TOKEN=
# Não use esses valores fictícios fora do desenvolvimento local.
# SQS_ENDPOINT_URL=http://localhost:4566
# SQS_REGION=us-east-1
# Exclusivamente desenvolvimento; troque as chaves fora do ambiente local.
# SQS_PROVIDER_KEYS='{"provider-a":"local-provider-a-signing-key-32-bytes-minimum","provider-b":"local-provider-b-signing-key-32-bytes-minimum"}'
# SQS_QUEUE_PREFIX=  # vazio preserva os nomes oficiais; usado para isolar testes

# Tamanho dos recursos por réplica (opcional; empty preserva defaults do pgx,
# e o Compose de entrega adota os resultados do A/B — ver ADR 0002).
# PG_POOL_MAX_CONNS=24
# OUTBOX_WORKERS=3

# Execute cmd/provision-sqs antes de habilitar SQS no servidor.
# Perfis independentes em arquivo AWS externo ao repositório (opcional).
# SQS_PROVISIONER_PROFILE=jungle-provisioner
# SQS_CONSUMER_PROFILE=jungle-consumer
# SQS_PUBLISHER_PROFILE=jungle-publisher
