# O processo lê o ambiente; não carrega .env automaticamente.
HTTP_ADDR=:8080
LOG_LEVEL=info

# Opcional nesta etapa: enquanto não há endpoints de negócio, a aplicação
# sobe sem banco quando esta variável está vazia. Exemplo local de teste.
# DATABASE_URL=postgres://jungle:jungle@localhost:5432/jungle?sslmode=disable
